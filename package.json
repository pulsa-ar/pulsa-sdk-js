{
  "name": "@pulsa/sdk",
  "version": "0.1.0",
  "description": "Argentine Sign Language (LSA) recognition in the browser: a camera component that streams to the pulsa API and reports glosses.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulsa-ar/pulsa-sdk-js.git"
  },
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./dist/index.js",
    "./dist/react.js",
    "./dist/pulsa.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "PROTOCOL.md"
  ],
  "scripts": {
    "dev": "vite --config vite.example.config.ts",
    "build:demo": "vite build --config vite.example.config.ts",
    "build": "vite build && vite build --config vite.standalone.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
